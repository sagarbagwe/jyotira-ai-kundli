generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum BirthTimeAccuracy {
  EXACT
  APPROXIMATE
  UNKNOWN
}

enum JobStatus {
  QUEUED
  CALCULATING
  ANALYZING
  GENERATING_REPORT
  COMPLETED
  FAILED
}

enum ReportStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

enum ReportType {
  BASIC
  DETAILED
  PREMIUM
}

enum UploadStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  REJECTED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  locale        String    @default("en")
  timezone      String    @default("Asia/Kolkata")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  birthProfiles BirthProfile[]
  reports       Report[]
  aiQuestions   AIQuestion[]
  uploadedFiles UploadedFile[]
  generationJobs GenerationJob[]
  usageEvents   UsageEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model BirthProfile {
  id           String            @id @default(cuid())
  userId       String
  name         String
  dateOfBirth  DateTime          @db.Date
  timeOfBirth  String
  place        String
  country      String
  latitude     Decimal           @db.Decimal(9, 6)
  longitude    Decimal           @db.Decimal(9, 6)
  timezone     String
  timeAccuracy BirthTimeAccuracy
  source       String            @default("manual")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  charts       KundliChart[]
  uploadedFiles UploadedFile[]

  @@index([userId, createdAt])
}

model KundliChart {
  id             String   @id @default(cuid())
  birthProfileId String
  version        Int      @default(1)
  engine         String
  engineVersion  String
  ayanamsa       String
  houseSystem    String
  nodeType       String
  julianDayUt    Decimal  @db.Decimal(16, 8)
  calculatedData Json
  calculatedAt   DateTime @default(now())
  checksum       String

  birthProfile       BirthProfile       @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)
  planetaryPositions PlanetaryPosition[]
  houses             House[]
  divisionalCharts   DivisionalChart[]
  dashas             Dasha[]
  transits           Transit[]
  yogas              Yoga[]
  doshas             Dosha[]
  reports            Report[]

  @@unique([birthProfileId, version])
  @@index([birthProfileId, calculatedAt])
}

model PlanetaryPosition {
  id                String   @id @default(cuid())
  chartId           String
  planet            String
  tropicalLongitude Decimal  @db.Decimal(10, 6)
  siderealLongitude Decimal  @db.Decimal(10, 6)
  latitude          Decimal  @db.Decimal(10, 6)
  speed             Decimal  @db.Decimal(10, 6)
  sign              String
  degreeInSign      Decimal  @db.Decimal(10, 6)
  house             Int
  nakshatra         String
  pada              Int
  retrograde        Boolean
  combust           Boolean
  dignity           String
  strengthScore     Int
  details           Json

  chart             KundliChart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@unique([chartId, planet])
  @@index([chartId, house])
}

model House {
  id            String @id @default(cuid())
  chartId       String
  number        Int
  sign          String
  lord          String
  cuspSidereal  Decimal @db.Decimal(10, 6)
  strengthScore Int
  details       Json

  chart         KundliChart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@unique([chartId, number])
}

model DivisionalChart {
  id          String  @id @default(cuid())
  chartId     String
  code        String
  name        String
  division    Int
  purpose     String
  reliability String
  available   Boolean
  ruleSet     String
  placements  Json

  chart       KundliChart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@unique([chartId, code])
}

model Dasha {
  id         String   @id @default(cuid())
  chartId    String
  system     String
  level      String
  lord       String
  parentLord String?
  startDate  DateTime
  endDate    DateTime
  path       String
  details    Json?

  chart      KundliChart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@index([chartId, startDate, endDate])
  @@index([chartId, path])
}

model Transit {
  id          String   @id @default(cuid())
  chartId     String
  planet      String
  eventType   String
  eventDate   DateTime
  fromSign    String?
  toSign      String?
  longitude   Decimal? @db.Decimal(10, 6)
  retrograde  Boolean
  natalHouse  Int?
  details     Json?

  chart       KundliChart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@index([chartId, eventDate])
}

model Yoga {
  id        String  @id @default(cuid())
  chartId   String
  ruleId    String
  name      String
  detected  Boolean
  status    String
  basis     Json
  rule      String
  caveat    String

  chart     KundliChart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@unique([chartId, ruleId])
}

model Dosha {
  id        String  @id @default(cuid())
  chartId   String
  ruleId    String
  name      String
  detected  Boolean
  status    String
  severity  String?
  basis     Json
  rule      String
  caveat    String

  chart     KundliChart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@unique([chartId, ruleId])
}

model Report {
  id             String       @id @default(cuid())
  userId         String
  chartId        String
  status         ReportStatus @default(DRAFT)
  type           ReportType
  language       String
  selectedSections String[]
  rangeStart     DateTime?
  rangeEnd       DateTime?
  title          String
  summary        String?      @db.Text
  interpretation Json?
  pdfStorageKey  String?
  shareEnabled   Boolean      @default(false)
  shareToken     String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chart          KundliChart  @relation(fields: [chartId], references: [id], onDelete: Cascade)
  sections       ReportSection[]
  questions      AIQuestion[]
  generationJobs GenerationJob[]

  @@index([userId, createdAt])
  @@index([chartId])
}

model ReportSection {
  id         String   @id @default(cuid())
  reportId   String
  key        String
  title      String
  sortOrder  Int
  content    Json
  generatedAt DateTime @default(now())
  model      String?

  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, key])
}

model AIQuestion {
  id            String   @id @default(cuid())
  userId        String
  reportId      String?
  question      String   @db.Text
  answer        Json?
  model         String?
  latencyMs     Int?
  inputTokens   Int?
  outputTokens  Int?
  status        String
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  report        Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([reportId])
}

model UploadedFile {
  id             String       @id @default(cuid())
  userId         String
  birthProfileId String?
  storageKey     String
  originalName   String
  mimeType       String
  sizeBytes      Int
  sha256         String
  status         UploadStatus @default(UPLOADED)
  extractedData  Json?
  errorCode      String?
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthProfile   BirthProfile? @relation(fields: [birthProfileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sha256])
}

model GenerationJob {
  id          String    @id @default(cuid())
  userId      String
  reportId    String?
  status      JobStatus @default(QUEUED)
  progress    Int       @default(0)
  currentStep String
  payload     Json
  result      Json?
  errorCode   String?
  errorMessage String?
  attempts    Int       @default(0)
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  report      Report?   @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, queuedAt])
  @@index([status, queuedAt])
}

model UsageEvent {
  id         String   @id @default(cuid())
  userId     String?
  kind       String
  quantity   Int      @default(1)
  durationMs Int?
  model      String?
  success    Boolean
  metadata   Json?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
  @@index([userId, createdAt])
}

model SystemError {
  id          String   @id @default(cuid())
  code        String
  area        String
  message     String
  fingerprint String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([area, createdAt])
  @@index([fingerprint])
}