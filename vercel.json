{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run vercel-build",
  "functions": {
    "src/app/api/stateless/report/route.ts": { "maxDuration": 300 },
    "src/app/api/stateless/chat/route.ts": { "maxDuration": 60 },
    "src/app/api/uploads/extract/route.ts": { "maxDuration": 60 }
  }
}
