# Stateless Gemini-only mode
# GEMINI_API_KEY is the only secret. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
AI_MODE=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=3
DEMO_MODE=true

# Optional local URL. Vercel supplies its deployment URL automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional deterministic astrology overrides (these are already the defaults).
ASTRO_ENGINE=swiss
AYANAMSA=lahiri
HOUSE_SYSTEM=whole-sign
NODE_TYPE=true
DASHA_YEAR_DAYS=365.2425

# Optional upload and request limits.
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_TYPES=application/pdf,image/png,image/jpeg
AI_REQUESTS_PER_HOUR=20
REPORTS_PER_DAY=5
LOCATION_PROVIDER=open-meteo
