# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Jyotira
NODE_ENV=development
DEMO_MODE=true

# PostgreSQL (Neon, Supabase, Railway, Prisma Postgres, or local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jyotira?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/jyotira?schema=public

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google Gemini (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=3
AI_MODE=gemini

# Astrology engine
ASTRO_ENGINE=swiss
AYANAMSA=lahiri
HOUSE_SYSTEM=whole-sign
NODE_TYPE=true
DASHA_YEAR_DAYS=365.2425

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_SECONDS=900

# Upload limits
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_TYPES=application/pdf,image/png,image/jpeg

# Rate limiting (optional locally, required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_REQUESTS_PER_HOUR=20
REPORTS_PER_DAY=5

# Logging / observability
LOG_LEVEL=info
SENTRY_DSN=

# Optional provider override. Open-Meteo is the built-in development provider.
LOCATION_PROVIDER=open-meteo
GOOGLE_MAPS_API_KEY=